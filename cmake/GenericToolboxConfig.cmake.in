@PACKAGE_INIT@
include(CMakeFindDependencyMacro)
find_dependency(Threads)

set(_toolboxModules Macro Log String Os Fs Vector Wrappers Utils Time Thread Stream Map Loops ZipIterator Misc MakeEnum GenericToolbox)
set(_toolboxWithRoot @GENERIC_TOOLBOX_WITH_ROOT@)
set(_toolboxWithJson @GENERIC_TOOLBOX_WITH_JSON@)
set(_toolboxWithYaml @GENERIC_TOOLBOX_WITH_YAML@)
foreach(_toolboxExtension IN ITEMS Root Json Yaml)
  if(_toolboxWith${_toolboxExtension})
    list(APPEND _toolboxModules ${_toolboxExtension})
  endif()
endforeach()

# A core-only consumer does not need dependencies of unused extensions.
set(_toolboxComponents ${GenericToolbox_FIND_COMPONENTS})
if(NOT _toolboxComponents OR "GenericToolbox" IN_LIST _toolboxComponents)
  set(_toolboxComponents ${_toolboxModules})
endif()
foreach(_toolboxComponent IN LISTS _toolboxComponents)
  if(_toolboxComponent IN_LIST _toolboxModules)
    set(GenericToolbox_${_toolboxComponent}_FOUND TRUE)
  else()
    set(GenericToolbox_${_toolboxComponent}_FOUND FALSE)
    set(GenericToolbox_NOT_FOUND_MESSAGE "GenericToolbox component '${_toolboxComponent}' was not installed")
  endif()
endforeach()
if("Root" IN_LIST _toolboxComponents AND _toolboxWithRoot)
  find_dependency(ROOT COMPONENTS Core RIO Hist Tree TreePlayer Matrix Graf Gpad MathCore)
endif()
if("Json" IN_LIST _toolboxComponents AND _toolboxWithJson)
  find_dependency(nlohmann_json CONFIG)
endif()
if("Yaml" IN_LIST _toolboxComponents AND _toolboxWithYaml)
  find_dependency(yaml-cpp CONFIG)
endif()
include("${CMAKE_CURRENT_LIST_DIR}/GenericToolboxTargets.cmake")
check_required_components(GenericToolbox)
